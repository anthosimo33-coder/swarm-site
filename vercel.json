{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/app/:path*",
      "destination": "/app.html"
    }
  ],
  "redirects": [
    {
      "source": "/compte",
      "destination": "/app/compte",
      "permanent": false
    }
  ]
}
